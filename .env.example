# ---------------------------------------------------------------------------
# VOW. — environment variables
# Copy to `.env.local` (never committed). Only VITE_* variables reach the browser.
# ---------------------------------------------------------------------------

# Supabase (Phase B) — public values only. The anon key is safe in the browser
# because every private table is protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL, used to build guest invitation links (e.g. https://vow.example.com)
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — set them as Supabase Edge Function secrets
# (`supabase secrets set ...`), NEVER with a VITE_ prefix, NEVER in the frontend.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=      (provided automatically to Edge Functions)
# STRIPE_SECRET_KEY=sk_test_...    (Phase C)
# STRIPE_WEBHOOK_SECRET=whsec_...  (Phase C)
